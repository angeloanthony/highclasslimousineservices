# Cloudflare Pages header rules.

# Astro fingerprints everything under /_astro/, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images are stable but not fingerprinted — a day, revalidated after.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pages are served extensionless (/weddings), so match everything. No
# Cache-Control here: Pages' default for HTML is already
# "public, max-age=0, must-revalidate", and setting it on /* would merge with
# the asset rules above.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org https://i.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://app.cal.com https://cal.com; connect-src 'self' https://app.cal.com https://cal.com https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'
