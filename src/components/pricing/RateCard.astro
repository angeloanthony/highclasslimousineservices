---
/**
 * Pricing guide: one vehicle class from the hourly-rate table. Only the
 * stretch limousines the business actually runs belong here.
 */
interface Props {
  title: string;
  capacity: string;
  rate: string;
  minimum: string;
  image: string;
  alt: string;
}

const { title, capacity, rate, minimum, image, alt } = Astro.props;
---

<article class="pg-rate">
  <div class="pg-rate__media">
    <img src={image} alt={alt} width="720" height="450" loading="lazy" decoding="async" />
  </div>
  <div class="pg-rate__body">
    <h3 class="pg-rate__title">{title}</h3>
    <p class="pg-rate__capacity">{capacity}</p>
    <p class="pg-rate__price">{rate}<span class="pg-rate__unit">per hour</span></p>
    <p class="pg-rate__min">Minimum {minimum}</p>
  </div>
</article>
