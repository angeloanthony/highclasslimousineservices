---
/**
 * Cal.com inline booking embed. Island: the loader only downloads on the
 * contact page, and only once the frame scrolls into view.
 */
interface Props {
  calLink?: string;
}

const { calLink = 'adventuretoursvernal/limousine-booking' } = Astro.props;
---

<div class="cal-frame reveal">
  <div class="cal-frame__corner cal-frame__corner--tl"></div>
  <div class="cal-frame__corner cal-frame__corner--tr"></div>
  <div class="cal-frame__corner cal-frame__corner--bl"></div>
  <div class="cal-frame__corner cal-frame__corner--br"></div>
  <div
    id="cal-booking"
    data-cal-link={calLink}
    style="width:100%;height:100%;overflow:scroll;min-height:680px;"
  >
  </div>
</div>

<script>
  const mount = document.getElementById('cal-booking');

  if (mount) {
    // Official Cal.com embed loader (their documented snippet), wrapped so the
    // ~40kB of third-party JS is only fetched once the widget is near-visible.
    const loadCal = () => {
      (function (C, A, L) {
        const p = function (a, ar) {
          a.q.push(ar);
        };
        const d = C.document;
        C.Cal =
          C.Cal ||
          function () {
            const cal = C.Cal;
            const ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () {
                p(api, arguments);
              };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else p(cal, ar);
              return;
            }
            p(cal, ar);
          };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      window.Cal('init', { origin: 'https://cal.com' });
      window.Cal('inline', {
        elementOrSelector: '#cal-booking',
        calLink: mount.dataset.calLink,
        layout: 'month_view',
      });
      window.Cal('ui', {
        theme: 'light',
        styles: { branding: { brandColor: '#b89d5e' } },
        hideEventTypeDetails: false,
        layout: 'month_view',
      });
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            loadCal();
          }
        },
        { rootMargin: '400px' }
      );
      io.observe(mount);
    } else {
      loadCal();
    }
  }
</script>
