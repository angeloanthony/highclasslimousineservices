---
interface Crumb {
  label: string;
  href?: string;
}

interface Hero {
  image: string;
  imageSmall?: string;
  width: number;
  height: number;
  alt: string;
  eyebrow?: string;
  subtitle?: string;
  benefits?: { icon: 'price' | 'vehicle' | 'occasion'; label: string }[];
}

interface Props {
  /** Plain leading part of the H1. */
  title: string;
  /** Trailing part rendered in the gold italic script face. */
  titleScript?: string;
  tagline?: string;
  crumbs?: Crumb[];
  /** Opt-in cinematic variant: full-bleed photo behind the heading. */
  hero?: Hero;
}

const { title, titleScript, tagline, crumbs = [], hero } = Astro.props;

// Line icons for the hero benefit row (stroke inherits currentColor).
const icons = {
  price: '<path d="M12 3v18M16.5 7.5c0-1.7-2-3-4.5-3s-4.5 1.3-4.5 3 2 2.6 4.5 3 4.5 1.3 4.5 3-2 3-4.5 3-4.5-1.3-4.5-3"/>',
  vehicle: '<path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l3 18 3-18"/>',
  occasion: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M14.5 14.2A5 5 0 0 1 21 19"/>',
};
---

<section class:list={['page-header', hero && 'page-header--hero']}>
  {
    hero && (
      <img
        class="page-header__bg"
        src={hero.image}
        srcset={hero.imageSmall ? `${hero.imageSmall} 800w, ${hero.image} ${hero.width}w` : undefined}
        sizes={hero.imageSmall ? '100vw' : undefined}
        width={hero.width}
        height={hero.height}
        alt={hero.alt}
        fetchpriority="high"
        decoding="async"
      />
    )
  }
  <div class="container">
    {
      crumbs.length > 0 && (
        <div class="breadcrumb">
          {crumbs.map((c, i) => (
            <>
              {c.href ? <a href={c.href}>{c.label}</a> : c.label}
              {/* Legacy markup was `<span>/</span> ` — the trailing space is
                  what separates the crumbs visually. */}
              {i < crumbs.length - 1 && (
                <>
                  <span>/</span>{' '}
                </>
              )}
            </>
          ))}
        </div>
      )
    }
    {hero?.eyebrow && <div class="page-header__eyebrow">{hero.eyebrow}</div>}
    <h1>
      {title}{' '}
      {titleScript && <span class="italic-script gold-text">{titleScript}</span>}
    </h1>
    {hero?.subtitle && <p class="page-header__subtitle">{hero.subtitle}</p>}
    {tagline && <p>{tagline}</p>}
    {
      hero?.benefits && hero.benefits.length > 0 && (
        <ul class="page-header__benefits">
          {hero.benefits.map((b) => (
            <li>
              <span class="page-header__benefit-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
              </span>
              {b.label}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
