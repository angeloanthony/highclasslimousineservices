---
interface Props {
  /** Adds the decorative drop cap to the first paragraph. */
  dropCap?: boolean;
  reveal?: boolean;
}

const { dropCap = false, reveal = true } = Astro.props;
---

<div
  class:list={['story-block', reveal && 'reveal', dropCap && 'has-drop-cap']}
>
  <slot />
</div>

<style>
  /* The legacy markup put class="drop-cap" directly on the first <p>. Markdown
     can't set a class on a paragraph, so target it structurally and reuse the
     exact declarations from .story-block .drop-cap in global.css. */
  .has-drop-cap > :global(p:first-child)::first-letter {
    font-family: var(--font-display);
    font-size: 4.5rem;
    float: left;
    line-height: 0.9;
    padding: 0.15em 0.15em 0 0;
    color: var(--gold-deep);
  }
</style>
