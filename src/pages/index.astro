---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import OfferCard from '../components/OfferCard.astro';
import MediaSplit from '../components/MediaSplit.astro';
import CtaFinal from '../components/CtaFinal.astro';
import { SITE, providerNode } from '../lib/site.js';

const testimonials = await getCollection('testimonials');
const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * Homepage offer cards carry pricing the service pages don't, so that copy
 * lives here. Everything else (title, image, order, badge) comes from the
 * service entry itself.
 */
const offerExtras: Record<
  string,
  {
    title: string;
    price: string;
    priceUnit?: string;
    blurb: string;
    features: string[];
    note: string;
  }
> = {
  '/weddings': {
    title: 'Weddings',
    price: '$1,295',
    blurb:
      'Luxury transportation for weddings, receptions, bridal parties, and photo stops throughout Vernal and surrounding Utah destinations.',
    features: [
      'Professional chauffeur',
      'Red carpet experience',
      'Multi-stop transportation',
      'Flexible hourly packages',
    ],
    note: '4–8 Hour Wedding Packages Available',
  },
  '/prom': {
    title: 'Prom & School Events',
    price: '$795',
    blurb:
      'Arrive in style for prom, dances, graduations, and school celebrations.',
    features: [
      'Safe group transportation',
      'Luxury stretch limousine',
      'Professional driver',
      'Custom pickup & drop-off',
    ],
    note: 'Weekend & Premium Dates May Apply',
  },
  '/airport': {
    title: 'Airport Transportation',
    price: '$350',
    blurb:
      'Reliable executive transportation to and from airports — on time, every time.',
    features: [
      'Vernal Regional Airport',
      'Salt Lake City International',
      'Private Air Services',
    ],
    note: 'Long-distance rates based on mileage & fuel',
  },
  '/corporate': {
    title: 'Corporate Travel',
    price: '$175',
    priceUnit: '/hr',
    blurb:
      'Professional executive transportation for business meetings, VIP clients, and corporate events across the energy sector and beyond.',
    features: [
      'Business meetings',
      'Energy sector travel',
      'VIP client transport',
      'Corporate events',
    ],
    note: 'Daily Executive Packages Available',
  },
  '/parties': {
    title: 'Parties & Special Events',
    price: '$495',
    blurb:
      'Birthdays, concerts, anniversaries, nights out, and holiday events — celebrated in pure VIP style.',
    features: [
      'Chauffeur service',
      'Luxury interior & lighting',
      'Group transportation',
      'Flexible scheduling',
    ],
    note: 'Holiday & Weekend Rates May Apply',
  },
  '/tours': {
    title: 'Scenic Utah Tours',
    price: '$995',
    blurb:
      'Explore Utah in comfort and style — from dinosaur country to canyon sunsets, with a chauffeur who knows the Basin.',
    features: [
      'Dinosaur National Monument',
      'Flaming Gorge',
      'Uintah Basin Scenic Routes',
      'Mountain & Canyon Tours',
    ],
    note: 'Custom full-day & sunset tours available',
  },
};

const trustItems = [
  {
    path: 'M12 2l2.39 6.95H21l-5.3 4.28L17.78 20 12 16.27 6.22 20l2.08-6.77L3 8.95h6.61L12 2z',
    title: 'Luxury Experience',
    body: 'Stretch limousine with premium interior, mood lighting, and VIP atmosphere.',
  },
  {
    title: 'On Time, Every Time',
    body: 'Professional chauffeurs, reliable scheduling, and a pristine fleet.',
    circle: true,
    path: 'M12 7v5l3 2',
  },
  {
    path: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z',
    extraCircle: true,
    title: 'Local to Vernal',
    body: 'Serving the Uintah Basin and greater Utah — proudly family-owned.',
  },
  {
    path: 'M20 6L9 17l-5-5',
    title: 'Every Occasion',
    body: 'Weddings, proms, parties, airports, business travel, and scenic tours.',
  },
];

const relatedReading = [
  {
    href: '/limousine-service-vernal-utah',
    title: 'Limousine Service in Vernal, Utah',
    blurb: 'The complete guide to every service we offer across the Basin.',
  },
  {
    href: '/how-much-does-a-limo-cost-in-vernal',
    title: 'How Much Does a Limo Cost in Vernal',
    blurb: 'Honest pricing for every service we run.',
  },
  {
    href: '/things-to-do-in-vernal-utah',
    title: 'Things to Do in Vernal, Utah',
    blurb: "A visitor's guide to the area, written by people who live here.",
  },
];

const schema = {
  ...providerNode,
  image: `${SITE.origin}${SITE.defaultOgImage}`,
  areaServed: SITE.areaServed,
  priceRange: '$$$',
  sameAs: [],
};
---

<BaseLayout
  title="High Class Limousine Services | Luxury Limo in Vernal, Utah"
  description="Luxury limousine service in Vernal, Utah. Premium transportation for weddings, proms, airport transfers, corporate travel, and VIP nights out. Class isn't extinct."
  path="/"
  schema={schema}
>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="Vernal limo service, Vernal limousine, Uintah Basin limo, wedding limo Vernal, prom limo Vernal, airport transportation Vernal Utah"
    />
  </Fragment>

  <!-- HERO -->
  <section class="hero hero--with-video">
    <div class="hero__media">
      <img
        src="/images/hero-poster.webp"
        alt="Luxury limousine at sunset in Vernal Utah"
        fetchpriority="high"
      />
    </div>
    <div class="container">
      <div class="hero__container">
        <div class="hero__content">
          <div class="hero__tag">Vernal · Utah</div>
          <h1>
            Ride in Style
            <span class="italic-script gold-text">Across the Basin & Beyond</span>
          </h1>
          <p class="hero__sub">
            Premium limousine transportation for weddings, airport transfers,
            proms, corporate travel, and unforgettable nights out. Cinematic
            experiences across Vernal, the Uintah Basin, and all of Utah.
          </p>
          <div class="hero__actions">
            <a href="/contact#quote" class="btn btn--gold">
              Book Your Ride <span class="btn__arrow">→</span>
            </a>
            <a href={SITE.phoneHref} class="btn btn--ghost-light">
              Call {SITE.phone}
            </a>
          </div>
        </div>

        <div class="video-frame reveal-scale">
          <div class="video-frame__inner">
            <div
              class="video-frame__placeholder"
              data-src="https://www.youtube.com/embed/pUA2SeXieiw?si=-88O5As1ButNzbIf"
              style="background-image:url('/images/hero-poster.webp');"
              role="button"
              tabindex="0"
              aria-label="Play video"
            >
              <div class="video-frame__play">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </div>
              <div class="video-frame__caption">Class Isn't Extinct</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__scroll">Scroll</div>
    <div class="hero__tagline">Class Isn't Extinct.</div>
  </section>

  <!-- TRUST STRIP -->
  <section class="trust">
    <div class="container">
      <div class="trust__grid reveal-stagger">
        {
          trustItems.map((item) => (
            <div class="trust__item">
              <svg class="trust__icon" viewBox="0 0 24 24" aria-hidden="true">
                {item.circle && <circle cx="12" cy="12" r="9" />}
                <path d={item.path} />
                {item.extraCircle && <circle cx="12" cy="10" r="3" />}
              </svg>
              <h4>{item.title}</h4>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SERVICES & PRICING -->
  <Section variant="offers">
    <SectionHead
      eyebrow="What We Offer"
      title="A Service"
      titleScript="for every moment"
      lead="From the aisle to the airport, from prom night to a sunset cruise through dinosaur country — every package includes professional chauffeur service and a pristine stretch limousine."
    />

    <div class="pricing__hourly reveal">
      <div class="pricing__hourly-label">
        <div class="eyebrow">Flexible Booking</div>
        <h3>Luxury Chauffeur Service</h3>
        <p>
          Need something custom? Our hourly service is perfect for multi-stop
          evenings, full business days, and experiences built entirely around
          you.
        </p>
      </div>

      <div class="pricing__hourly-rate">
        <span class="pricing-card__from">Vernal & Uintah Basin Rates</span>

        <div class="pricing__tier-grid">
          <div class="pricing__tier">
            <span class="pricing__tier-label">First Hour</span>
            <span class="pricing__tier-amount">$220</span>
          </div>
          <div class="pricing__tier-divider">+</div>
          <div class="pricing__tier">
            <span class="pricing__tier-label">Each Additional Hour</span>
            <span class="pricing__tier-amount"
              >$110<span class="pricing__tier-unit">/hr</span></span
            >
          </div>
        </div>

        <div class="pricing__slc-note">
          <span class="pricing__slc-badge">SLC</span>
          Salt Lake City package pricing available — <a href="/contact#quote"
            >request a quote</a
          >
        </div>

        <ul class="pricing__hourly-notes">
          <li>2–4 hour minimums may apply</li>
          <li>Weekend & holiday pricing varies</li>
          <li>Fuel surcharges for long-distance travel</li>
        </ul>
      </div>

      <a href="/contact#quote" class="btn btn--gold"
        >Get a Custom Quote <span class="btn__arrow">→</span></a
      >
    </div>

    <div class="offers__grid reveal-stagger">
      {
        services.map((s) => {
          const extra = offerExtras[s.data.path];
          return (
            <OfferCard
              href="/contact#quote"
              num={String(s.data.order).padStart(2, '0')}
              title={extra.title}
              image={s.data.cardImage}
              blurb={extra.blurb}
              badge={s.data.badge}
              featured={s.data.featured}
              price={extra.price}
              priceUnit={extra.priceUnit}
              features={extra.features}
              note={extra.note}
              buttonLabel="Book Now"
              buttonVariant={s.data.featured ? 'gold' : 'outline'}
            />
          );
        })
      }
    </div>

    <div class="pricing__tagline reveal">
      <p>
        Every ride includes professional chauffeur service, luxury
        accommodations, and reliable transportation designed to make your
        experience unforgettable.
      </p>
    </div>
  </Section>

  <!-- EXPERIENCE -->
  <Section variant="experience">
    <MediaSplit
      image="/images/experience-limo.webp"
      alt="High Class Limousine interior with gold mood lighting"
      eyebrow="The Experience"
      title="Luxury"
      titleScript="isn't the trip."
      titleTail="It's the memory."
      badge="The · High · Class · Experience"
      decorated={false}
      signature="— Class Isn't Extinct."
    >
      <p>
        At High Class Limousine Services, we believe your ride should be as
        unforgettable as the destination. Based in Vernal, Utah, we blend
        premium transportation with bold personality, cinematic scenery, and
        genuine VIP treatment.
      </p>
      <p>
        Climb inside, let the gold lights glow, and watch the Uintah Basin roll
        past the tinted glass. This is how you arrive. This is how you remember.
      </p>
      <a href="/about" class="btn btn--outline mt-2">
        Our Story <span class="btn__arrow">→</span>
      </a>
    </MediaSplit>
  </Section>

  <!-- FLEET SHOWCASE -->
  <section class="fleet">
    <div class="fleet__showcase">
      <div class="fleet__content">
        <div class="eyebrow">The Fleet</div>
        <h2>Built for the <span class="italic-script gold-text">moment.</span></h2>
        <p>
          Our stretch limousine is outfitted with premium leather seating,
          fiber-optic mood lighting, a full sound system, and room for your whole
          VIP party.
        </p>
        <div class="fleet__specs">
          <div class="fleet__spec">
            <strong>10</strong>
            <span>Passengers</span>
          </div>
          <div class="fleet__spec">
            <strong>VIP</strong>
            <span>Lighting & Sound</span>
          </div>
          <div class="fleet__spec">
            <strong>24/7</strong>
            <span>Available</span>
          </div>
        </div>
        <div class="mt-2">
          <a href="/gallery" class="btn btn--gold"
            >View The Fleet <span class="btn__arrow">→</span></a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">Guest Reviews</div>
        <h2>The <span class="italic-script gold-text">verdict</span> is in</h2>
      </div>
      <div class="testimonials__grid reveal-stagger">
        {
          testimonials.map((t) => (
            <div class="testimonial">
              <div class="testimonial__stars">{'★ '.repeat(t.data.stars).trim()}</div>
              <p class="testimonial__text">{t.data.quote}</p>
              <div class="testimonial__author">
                {t.data.author}
                <span class="testimonial__role">{t.data.role}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RELATED READING -->
  <section style="background:#f5efe6;color:inherit;">
    <div class="container">
      <div class="section-head" style="text-align:center;">
        <span class="eyebrow gold-text">Related Reading</span>
        <h2 style="color:inherit;">
          Keep <span class="italic-script gold-text">exploring.</span>
        </h2>
      </div>
      <div class="services__grid" style="margin-top:2rem;">
        {
          relatedReading.map((r) => (
            <a
              href={r.href}
              class="service-card"
              style="text-decoration:none;color:inherit;display:block;"
            >
              <h3 style="margin-top:0;color:inherit;">{r.title}</h3>
              <p style="color:#555;">{r.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaFinal
    title="Ready to"
    titleScript="ride in style?"
    sub="Book your luxury limousine experience today."
    primaryLabel="Request a Quote"
    secondaryLabel="Call Now"
  />
</BaseLayout>
